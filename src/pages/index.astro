---
import VoiceCard from "../components/VoiceCard.astro";
import Icon from "../components/Icon.astro";
import { TOPICS, TOPIC_LABELS, TOPIC_ICONS } from "../../lib/taxonomy.mjs";
import voices from "../../data/us/voices.json";
import meta from "../../data/meta.json";

// ビルド時に data/*.json を読み込む純粋な静的サイト（SSG）。
// 新しい順に並べる（fetch-voices.mjs 側でも並べているが、フロントでも保証しておく）。
const items = [...voices].sort((a, b) => b.created_utc - a.created_utc);

// 実際に出現する topic だけタブに出す（空タブを作らない）
const usedTopics = TOPICS.filter((t) => items.some((v) => v.topic === t));

const updated = meta?.updated_at
  ? new Date(meta.updated_at).toLocaleDateString("ja-JP", { month: "long", day: "numeric" })
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chillmeru（チルメル）— 海外の検査技師のいま</title>
    <meta
      name="description"
      content="海外の臨床検査技師の『現場の声』を、日本語でサッと。読み取り専用・日次更新。"
    />
    <meta name="theme-color" content="#0b0f14" />
    <meta property="og:title" content="Chillmeru（チルメル）" />
    <meta property="og:description" content="海外の臨床検査技師の『現場の声』を、日本語でサッと。" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%A7%AA%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <div class="brand">
          <Icon name="flask" class="mark" stroke={2.2} />
          <span class="name">Chillmeru</span>
          <span class="sub">チルメル</span>
        </div>
        {updated && <span class="updated">{updated} 更新</span>}
      </header>

      <p class="lead">海外の臨床検査技師の「現場の声」を、日本語でサッと。</p>

      <nav class="filters" aria-label="トピックで絞り込み">
        <button class="chip is-active" data-filter="all" type="button">すべて</button>
        {
          usedTopics.map((t) => (
            <button class="chip" data-filter={t} type="button">
              <Icon name={TOPIC_ICONS[t]} class="chip-icon" />
              {TOPIC_LABELS[t]}
            </button>
          ))
        }
      </nav>

      {
        items.length === 0 ? (
          <p class="empty">まだ声がありません。日次パイプラインが動くと、ここに並びます。</p>
        ) : (
          <main class="feed">
            {items.map((v) => <VoiceCard voice={v} />)}
          </main>
        )
      }

      <footer class="foot">
        <p>要約はすべて元投稿へリンク。原文は保存せず、敬意とトラフィックを原典に返します。</p>
        <p class="muted">Chillmeru · 非商用 · 読み取り専用</p>
      </footer>
    </div>

    <script>
      // トピックチップでのフィルタ（フレームワーク不要の素のJS）
      const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
      const posts = document.querySelectorAll<HTMLElement>(".post");
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const filter = chip.dataset.filter;
          chips.forEach((c) => c.classList.toggle("is-active", c === chip));
          posts.forEach((post) => {
            const show = filter === "all" || post.dataset.topic === filter;
            post.style.display = show ? "" : "none";
          });
        });
      });
    </script>

    <style is:global>
      :root {
        /* ダーク基調（SNS風・ニュートラル + 1アクセント）。ライトは下で上書き */
        --bg: #0b0f14;
        --surface: #141a21;
        --surface-2: #1b232d;
        --ink: #eaf0f6;
        --ink-soft: #9fb0c0;
        --ink-faint: #66788a;
        --line: #1f2831;
        --accent: #4c8dff;
        --accent-ink: #ffffff;
        --aru: #e8b84b;
        --moya: #9b8cff;
        /* topic ごとのアクセント（フィードに色のリズムを出す） */
        --t-workload: #e88a4d;
        --t-salary: #43b581;
        --t-career: #5b9bff;
        --t-certification: #a082f0;
        --t-culture: #3fb6b6;
        --maxw: 600px;
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #ffffff;
          --surface: #f7f9fb;
          --surface-2: #eef2f6;
          --ink: #131a22;
          --ink-soft: #56636f;
          --ink-faint: #8a97a4;
          --line: #e6ebf0;
          --accent: #2563eb;
          --accent-ink: #ffffff;
          --aru: #a06a00;
          --moya: #5b46d6;
          --t-workload: #c2652b;
          --t-salary: #1f9d63;
          --t-career: #2563eb;
          --t-certification: #6d4fd0;
          --t-culture: #178a8a;
        }
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN",
          "Hiragino Sans", "Noto Sans JP", Meiryo, sans-serif;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .app {
        width: min(var(--maxw), 100%);
        margin-inline: auto;
        min-height: 100vh;
        border-inline: 1px solid var(--line);
        background: var(--bg);
      }

      /* 上部の固定バー */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.7rem 1rem;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(1.4) blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .brand { display: flex; align-items: center; gap: 0.4rem; }
      .brand .mark { width: 1.25rem; height: 1.25rem; color: var(--accent); }
      .brand .name {
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: 0.01em;
        background: linear-gradient(90deg, var(--accent), #3fb6b6);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .brand .sub { font-size: 0.72rem; color: var(--ink-faint); }
      .updated { font-size: 0.72rem; color: var(--ink-faint); white-space: nowrap; }

      .lead {
        margin: 0;
        padding: 0.9rem 1rem 0.2rem;
        color: var(--ink-soft);
        font-size: 0.92rem;
      }

      /* トピックのチップ（横スクロール） */
      .filters {
        position: sticky;
        top: 49px;
        z-index: 9;
        display: flex;
        gap: 0.45rem;
        padding: 0.7rem 1rem;
        overflow-x: auto;
        scrollbar-width: none;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(1.4) blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .filters::-webkit-scrollbar { display: none; }
      .chip {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        appearance: none;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--ink-soft);
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        font-size: 0.86rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
      }
      .chip-icon { width: 1em; height: 1em; opacity: 0.85; }
      .chip:hover { color: var(--ink); border-color: var(--accent); }
      .chip.is-active {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--accent-ink);
      }

      /* フィード */
      .feed { display: flex; flex-direction: column; gap: 0.7rem; padding: 0.85rem; }

      .post {
        --ac: var(--accent);
        position: relative;
        background: var(--surface);
        border: 1px solid var(--line);
        border-left: 4px solid var(--ac);
        border-radius: 14px;
        padding: 0.95rem 1rem 0.9rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
      }
      .post:hover {
        background: var(--surface-2);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
      }
      .post[data-topic="workload"] { --ac: var(--t-workload); }
      .post[data-topic="salary"] { --ac: var(--t-salary); }
      .post[data-topic="career"] { --ac: var(--t-career); }
      .post[data-topic="certification"] { --ac: var(--t-certification); }
      .post[data-topic="culture"] { --ac: var(--t-culture); }

      .meta {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        font-size: 0.82rem;
        color: var(--ink-faint);
      }
      .meta .source { color: var(--ink-soft); font-weight: 700; }
      .meta .dot { opacity: 0.6; }
      .topic-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        margin-left: auto;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 0.14rem 0.55rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--ac) 16%, transparent);
        color: var(--ac);
      }
      .tag-icon { width: 0.95em; height: 0.95em; }

      .title {
        margin: 0.4rem 0 0.3rem;
        font-size: 1.12rem;
        font-weight: 800;
        line-height: 1.45;
        letter-spacing: 0.005em;
      }
      .summary {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .resonance {
        display: inline-flex;
        align-items: center;
        gap: 0.32rem;
        margin-top: 0.65rem;
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.24rem 0.62rem;
        border-radius: 999px;
      }
      .r-icon { width: 1em; height: 1em; }
      .resonance-aruaru {
        background: color-mix(in srgb, var(--aru) 18%, transparent);
        color: var(--aru);
      }
      .resonance-moyamoya {
        background: color-mix(in srgb, var(--moya) 20%, transparent);
        color: var(--moya);
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        margin-top: 0.85rem;
        font-size: 0.82rem;
        color: var(--ink-faint);
      }
      .stat { display: inline-flex; align-items: center; gap: 0.32rem; }
      .stat svg { width: 1.05em; height: 1.05em; }
      .source-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-left: auto;
        color: var(--accent);
        text-decoration: none;
        font-weight: 700;
      }
      .source-link svg { width: 1em; height: 1em; }
      .source-link:hover { text-decoration: underline; }

      .empty { color: var(--ink-soft); text-align: center; padding: 4rem 1rem; }

      .foot {
        padding: 1.4rem 1rem 2.4rem;
        font-size: 0.8rem;
        color: var(--ink-faint);
      }
      .foot p { margin: 0.25rem 0; }
      .foot .muted { opacity: 0.8; }
    </style>
  </body>
</html>
