---
import { TOPIC_LABELS, RESONANCE_LABELS } from "../../lib/taxonomy.mjs";

// 1件の「現場の声」カード。原文bodyは持たない設計なので、要約と指標だけを表示する。
const { voice } = Astro.props;
const topicLabel = TOPIC_LABELS[voice.topic] ?? voice.topic;
const resonanceLabel = voice.resonance ? RESONANCE_LABELS[voice.resonance] : null;

const created = new Date(voice.created_utc * 1000).toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class="card" data-topic={voice.topic} data-resonance={voice.resonance ?? ""}>
  <header class="card-head">
    <span class={`badge topic topic-${voice.topic}`}>{topicLabel}</span>
    {
      resonanceLabel && (
        <span class={`badge resonance resonance-${voice.resonance}`}>{resonanceLabel}</span>
      )
    }
  </header>

  <h2 class="card-title">{voice.title_ja}</h2>
  <p class="card-summary">{voice.summary_ja}</p>

  <footer class="card-foot">
    <span class="metric" title="スコア">▲ {voice.score.toLocaleString()}</span>
    <span class="metric" title="コメント数">💬 {voice.num_comments.toLocaleString()}</span>
    <span class="metric date">{created}</span>
    <a class="source" href={voice.url} target="_blank" rel="noopener noreferrer">
      元投稿を読む ↗
    </a>
  </footer>
</article>
