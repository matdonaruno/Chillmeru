---
import {
  TOPIC_LABELS,
  RESONANCE_LABELS,
  TOPIC_ICONS,
  RESONANCE_ICONS,
} from "../../lib/taxonomy.mjs";

// 1件の「現場の声」カード。SNSの投稿風。原文bodyは持たない設計なので、要約と指標だけを表示する。
const { voice } = Astro.props;
const topicLabel = TOPIC_LABELS[voice.topic] ?? voice.topic;
const topicIcon = TOPIC_ICONS[voice.topic] ?? "🧪";
const resonanceLabel = voice.resonance ? RESONANCE_LABELS[voice.resonance] : null;
const resonanceIcon = voice.resonance ? RESONANCE_ICONS[voice.resonance] : null;

// 発信元サブレディットを URL から取り出す（例: r/medlabprofessionals）
const subMatch = voice.url.match(/reddit\.com\/(r\/[^/]+)/i);
const source = subMatch ? subMatch[1] : "reddit";

// 相対時間（「3日前」など）。SNSっぽさを出す。
function relativeTime(unixSec) {
  const diffMs = unixSec * 1000 - Date.now();
  const rtf = new Intl.RelativeTimeFormat("ja", { numeric: "auto" });
  const units = [
    ["year", 31536000],
    ["month", 2592000],
    ["day", 86400],
    ["hour", 3600],
    ["minute", 60],
  ];
  const absSec = Math.abs(diffMs) / 1000;
  for (const [unit, sec] of units) {
    if (absSec >= sec) return rtf.format(Math.round(diffMs / 1000 / sec), unit);
  }
  return rtf.format(Math.round(diffMs / 1000 / 60), "minute");
}
const when = relativeTime(voice.created_utc);
---

<article class="post" data-topic={voice.topic} data-resonance={voice.resonance ?? ""}>
  <div class={`avatar topic-${voice.topic}`} aria-hidden="true">{topicIcon}</div>

  <div class="body">
    <div class="meta">
      <span class="source">{source}</span>
      <span class="dot">·</span>
      <span class="time">{when}</span>
      <span class={`topic-tag topic-${voice.topic}`}>{topicLabel}</span>
    </div>

    <h2 class="title">{voice.title_ja}</h2>
    <p class="summary">{voice.summary_ja}</p>

    {
      resonanceLabel && (
        <div class={`resonance resonance-${voice.resonance}`}>
          <span class="r-icon" aria-hidden="true">{resonanceIcon}</span>
          {resonanceLabel}
        </div>
      )
    }

    <div class="actions">
      <span class="stat" title="スコア"><span aria-hidden="true">▲</span> {voice.score.toLocaleString()}</span>
      <span class="stat" title="コメント数"><span aria-hidden="true">💬</span> {voice.num_comments.toLocaleString()}</span>
      <a class="source-link" href={voice.url} target="_blank" rel="noopener noreferrer">
        元投稿を読む<span aria-hidden="true"> ↗</span>
      </a>
    </div>
  </div>
</article>
