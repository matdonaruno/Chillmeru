---
// ミニマルなラインアイコン（インラインSVG、依存なし）。
// name は lib/taxonomy.mjs の TOPIC_ICONS / RESONANCE_ICONS が持つ値と一致させる。
// アイコンデータの実体は lib/icons.mjs（クライアント側フィードレンダラーと共有）。
import { ICON_PATHS } from "../../lib/icons.mjs";

const { name, size = "1em", stroke = 2, class: cls } = Astro.props;
const inner = ICON_PATHS[name] ?? "";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={inner}
></svg>
